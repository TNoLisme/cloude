{
  "name": "digital-banking-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/openapi.d.ts",
    "api:check": "node scripts/check-api.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json index.html",
    "api:smoke": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-query": "5.80.7",
    "antd": "5.26.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.6.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
