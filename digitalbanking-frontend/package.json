{
  "name": "digitalbanking-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../digitalbanking-docs/openapi/digital-banking-v1.yaml -o src/shared/api/generated/openapi.d.ts",
    "api:check": "node scripts/check-api.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json index.html",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "api:smoke:legacy": "node scripts/api-smoke.mjs",
    "dev:api": "vite --mode development --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-query": "5.80.7",
    "antd": "5.26.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "zustand": "5.0.5",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7",
    "@hookform/resolvers": "7.0.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.6.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "7.3.8",
    "vitest": "3.2.4",
    "msw": "2.15.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
