diff --git a/digitalbanking-backend/src/main/java/com/simulatedbank/banking/admin/adapter/in/StrictStringDeserializer.java b/digitalbanking-backend/src/main/java/com/simulatedbank/banking/admin/adapter/in/StrictStringDeserializer.java
new file mode 100644
index 0000000..499ac33
--- /dev/null
+++ b/digitalbanking-backend/src/main/java/com/simulatedbank/banking/admin/adapter/in/StrictStringDeserializer.java
@@ -0,0 +1,18 @@
+package com.simulatedbank.banking.admin.adapter.in;
+
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import com.fasterxml.jackson.databind.DeserializationContext;
+import com.fasterxml.jackson.databind.JsonDeserializer;
+import java.io.IOException;
+
+/** Admin contract strings must not be coerced from JSON numbers or booleans. */
+public final class StrictStringDeserializer extends JsonDeserializer<String> {
+    @Override
+    public String deserialize(JsonParser parser, DeserializationContext context) throws IOException {
+        if (!parser.hasToken(JsonToken.VALUE_STRING)) {
+            return context.reportInputMismatch(String.class, "value must be a string");
+        }
+        return parser.getText();
+    }
+}
